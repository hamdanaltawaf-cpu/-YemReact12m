---
// صورة مصغّرة ثابتة للرياكشن (بطاقات المكتبة) — قالب الكليب المطبق
import { categoryColors } from '../lib/tokens.js';
import Qusasa from './Qusasa.astro';

interface Props { reaction: Record<string, any>; size?: 'lg' | 'sm'; }
const { reaction, size = 'lg' } = Astro.props;

const catColor = categoryColors[reaction.cat] || 'var(--paper)';
const corner = reaction.corner === 'tl' ? 'tl' : 'tr';
const side = corner === 'tr' ? 'left' : 'right';
---
<div class={`card-thumb ${size === 'sm' ? '' : 'torn-lg'}`}>
  {reaction.thumb ? (
    <img src={reaction.thumb} alt={reaction.quote} loading="lazy" />
  ) : (
    <div class="card-placeholder">
      <Qusasa size={36} fill="rgba(243,234,224,.5)" />
    </div>
  )}

  <div class={`peel ${corner}`}>
    <Qusasa size={20} fill="var(--ink)" />
  </div>

  {reaction.dur > 0 && <div class={`dur-tag ${side} mono`}>{reaction.dur}s</div>}
  <div class={`cat-dot ${side}`} style={`background:${catColor}`} />

  <slot />
</div>
