---
import Layout from '../layouts/Layout.astro';
import HomeBrowser from '../islands/HomeBrowser.jsx';
import SubmitReaction from '../islands/SubmitReaction.jsx';
import Qusasa from '../components/Qusasa.astro';
import { brand } from '../lib/tokens.js';
---

<Layout>
  <section class="hero" style="padding-top: 30px;">
    <div class="hero-lockup">
      <Qusasa size={30} />
      <span class="hero-word">{brand.nameAr}</span>
    </div>
    <h1 class="hero-h1">مكتبة رياكشنات يمنية.<br />مو صفحة ميمز.</h1>
    <p class="hero-sub">دوّر بالموقف اللي فيه، مو بالمشاعر.</p>
  </section>

  <HomeBrowser client:load />
  <SubmitReaction client:load />
</Layout>
