---
import '../styles/global.css';
import Qusasa from '../components/Qusasa.astro';
import { brand, fonts } from '../lib/tokens.js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = 'يمن رياكت — مكتبة رياكشنات يمنية',
  description = 'مكتبة رياكشنات يمنية نادرة ومنتقاة — خذها. حطها. يمنية.',
  image,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph (معاينة غنية عند المشاركة) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.nameAr} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ar_YE" />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#121214" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="يمن رياكت" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <script>
      // تسجيل Service Worker (PWA)
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <!-- خطوط العلامة (Lalezar + Cairo + Archivo Black + Inter + IBM Plex Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lalezar&family=Cairo:wght@400;600;700;800&family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="brand-lockup" aria-label="يمن رياكت">
          <Qusasa size={26} />
          <span class="word">{brand.nameAr}</span>
          <span class="en ltr">YemReact</span>
        </a>
        <nav class="header-links">
          <a href="/" class="header-link">المكتبة</a>
          <a href="/account" class="header-link">حسابي</a>
          <a href="/#submit" class="header-btn">أرسل رياكشن</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="tagline">{brand.tagline}</div>
      <nav class="footer-links">
        <a href="/privacy">سياسة الخصوصية</a>
        <a href="/terms">شروط الاستخدام</a>
        <a href="/report">الإبلاغ عن محتوى</a>
      </nav>
      <p class="fine mono">YEMREACT — LIBRARY OF YEMENI REACTIONS</p>
    </footer>
  </body>
</html>
