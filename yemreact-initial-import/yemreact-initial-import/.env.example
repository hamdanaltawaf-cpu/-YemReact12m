# ============================================================
# YemReact — نموذج ملف البيئة
# انسخه إلى `.env` واملأ القيم. لا تُرفع القيم الحقيقية للتحكم بالإصدار.
# ============================================================

# --- التشغيل ---
NODE_ENV=development          # development | test | production
HOST=0.0.0.0
PORT=4173
# الرابط العام للموقع (لوسوم OpenGraph وروابط المشاركة)
SITE_URL=http://localhost:4173

# --- قاعدة البيانات (PostgreSQL) ---
DATABASE_URL=postgres://yemreact:yemreact_dev@127.0.0.1:5432/yemreact

# --- الأسرار (إلزامية في الإنتاج — استبدلها بقيم عشوائية قوية) ---
# توليد سريع: openssl rand -hex 32
SESSION_SECRET=change-me
ADMIN_SECRET=change-me
OTP_SALT=change-me
IP_SALT=change-me
# كلمة سر لوحة الإدارة
YEMREACT_ADMIN_PASSWORD=change-me

# --- التخزين (واجهة قابلة للتبديل) ---
# local (قرص محلي الآن) | s3 (Cloudflare R2 / AWS S3 لاحقًا)
STORAGE_TRANSPORT=local
STORAGE_LOCAL_DIR=data/media
PUBLIC_MEDIA_BASE_URL=/media

# --- البريد (واجهة قابلة للتبديل) ---
# dev (يطبع الرمز في السجل ويُرجعه للعميل في غير الإنتاج) | resend (بريد حقيقي)
MAIL_TRANSPORT=dev
MAIL_FROM=YemReact <no-reply@yemreact.dev>
# مطلوب فقط عند MAIL_TRANSPORT=resend
RESEND_API_KEY=

# --- شارة "مساهِم موثوق" (عدد المساهمات المقبولة) ---
TRUSTED_CONTRIBUTOR_THRESHOLD=3

# --- معالجة الوسائط (واجهة قابلة للتبديل) ---
MEDIA_TRANSPORT=local
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_BYTES=83886080        # 80 ميغابايت

# --- حماية معدّل الطلبات ---
RATE_LIMIT_MAX=1000
RATE_LIMIT_SUBMISSIONS_MAX=10

# --- إعادة بناء الواجهة (SSG) عند النشر ---
# true: يُعاد البناء تلقائيًا (بيئات غير Docker). false: في Docker (البناء عند النشر)
REBUILD_ON_PUBLISH=true
REBUILD_DEBOUNCE_MS=3000
