{
  "name": "yemreact",
  "version": "1.0.0",
  "description": "يمن رياكت — مكتبة رياكشنات يمنية مصنّفة حسب المواقف. خذها. حطها. يمنية.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/seed/seed.js",
    "db:setup": "node src/db/migrate.js && node src/seed/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
