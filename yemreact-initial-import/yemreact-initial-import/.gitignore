.env.*
!.env.example

# بيانات التشغيل المحلي (قاعدة بيانات محلية + وسائط مرفوعة)
data/
*.log

# مخرجات النظام
.DS_Store
coverage/
*.tmp

# لقطات معاينة من بيئة الاختبار (ليست مصدرًا)
docs/screenshots/

